# Station runtime state — per-session, not source
.station/

# Prose VM run artifacts, should never land in a project repo
.prose/
runs/
.agents/prose/runs/

# Installed dependencies — never source. The self-contained src/ modules install
# their own devDeps and never commit a lockfile; web/ is the deployable app (ADR
# 0002) and DOES commit web/package-lock.json for reproducible builds, so the
# lockfile ignore is anchored to the src/ module track only.
node_modules/
src/*/package-lock.json

# OS / editor cruft
.DS_Store
*.swp

# agent runtime artifacts
.claude/

# auth files
AUTH.md
AUTH.*.md

# === STATION MANAGED BEGIN — DO NOT EDIT ===
# Auto-written by services/api/src/station/daemons/project_file_janitor.py
# Edit at /admin/settings/gitignore — rewrites happen within ~2s of save.
.station-evidence/
.cursor/mcp.json
*.STATION_AUTO_MANAGED_DO_NOT_EDIT.md
.mcp.json
.agents/
.claude/
.codex/config.toml
.station/
# === STATION MANAGED END ===
